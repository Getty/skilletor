{
  "name": "skilletor",
  "version": "0.9.0",
  "license": "Artistic-2.0",
  "private": true,
  "type": "module",
  "description": "Remote skills, agents and rules for Claude Code, Codex and Hermes Agent – declared once, synced on every session, templated per project.",
  "bin": {
    "skilletor": "bin/skilletor"
  },
  "gettyBun": {
    "contractVersion": 1,
    "bunVersion": "1.4.5"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "check-dist": "bun scripts/check-dist.mjs",
    "check-starters": "bun scripts/check-starters.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./test/setup.ts --parallel --timeout=60000 ./test/"
  },
  "dependencies": {
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/nunjucks": "^3.2.6",
    "smol-toml": "^1.9.0",
    "typescript": "^7.0.2"
  }
}
