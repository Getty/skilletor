#!/bin/sh
# skilletor launcher: require Node.js >= 18, then run the bundled CLI.
#
# On Windows, Claude Code and PowerShell/cmd start bin/skilletor.exe (winlaunch)
# instead, which runs the bundle with the first node.exe on PATH:
# winlaunch: run node {root}/dist/skilletor.js
set -eu

if ! command -v node >/dev/null 2>&1; then
  echo "skilletor: Node.js is required but was not found on PATH (need >= 18)." >&2
  exit 1
fi

major=$(node -e 'process.stdout.write(String(process.versions.node.split(".")[0]))' 2>/dev/null || true)
case "$major" in
  '' | *[!0-9]*)
    echo "skilletor: could not determine the Node.js version (need >= 18)." >&2
    exit 1
    ;;
esac

if [ "$major" -lt 18 ]; then
  echo "skilletor: Node.js >= 18 is required, but found $(node --version)." >&2
  exit 1
fi

# Follow our own symlink chain (a link on PATH, npm link, npm install -g) to the real
# file: dist/ sits next to the checkout's bin/, not the link's. No `readlink -f` (macOS
# sh has none); a relative target is relative to the directory of the link naming it.
self=$0
while [ -L "$self" ]; do
  target=$(readlink -- "$self")
  case "$target" in
    /*) self=$target ;;
    *) self=$(dirname -- "$self")/$target ;;
  esac
done

root=$(CDPATH= cd -P -- "$(dirname -- "$self")/.." && pwd)
exec node "$root/dist/skilletor.js" "$@"
