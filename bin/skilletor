#!/bin/sh
# skilletor: the CLI on POSIX, for a link on PATH, install.sh's clone install and a checkout.
# It runs the bundle through the getty-bun starter beside it (bootstrap/getty-bun.sh), which
# installs the pinned Bun on first use; options pass through unchanged (k281). The plugin's
# hooks call the starter themselves (hooks/hooks.json, hooks/codex-hooks.json).

# Follow our own symlink chain (a link on PATH, npm link, npm install -g) to the real file: the
# starter sits in the checkout, not beside the link. No `readlink -f` (macOS sh has none); a
# relative target is relative to the directory of the link naming it.
self=$0
while [ -L "$self" ]; do
  target=$(readlink -- "$self")
  case "$target" in
    /*) self=$target ;;
    *) self=$(dirname -- "$self")/$target ;;
  esac
done
root=$(CDPATH='' cd -P -- "$(dirname -- "$self")/.." && pwd) || exit 1
exec sh "$root/bootstrap/getty-bun.sh" run dist/skilletor.js "$@"
