{
  "description": "The CLI's argument layer, byte for byte: --version only first, --help anywhere and alone, the options each command accepts, an unknown option, command or --scope (a missing value is the string undefined, k170), a missing operand (an empty one counts as missing for trust) – nothing runs, so the user's config stays as it was and no sync installs foo.",
  "git": {
    "shared": { "url": "https://conformance.invalid/shared.git", "commits": [{ "tree": "sources/shared" }] }
  },
  "steps": [
    { "id": "version", "op": "cli", "argv": ["--version"], "version": true },
    { "id": "version-short-first", "op": "cli", "argv": ["-v", "sync"], "version": true },
    { "id": "version-later", "op": "cli", "argv": ["sync", "--version"] },
    { "id": "version-short-later", "op": "cli", "argv": ["sync", "-v"] },
    { "id": "help", "op": "cli", "argv": ["--help"], "version": true },
    { "id": "help-no-arguments", "op": "cli", "argv": [], "version": true },
    { "id": "help-after-command", "op": "cli", "argv": ["sync", "--help"], "version": true },
    { "id": "help-short", "op": "cli", "argv": ["uninstall", "foo@shared", "-h"], "version": true },
    { "id": "help-first", "op": "cli", "argv": ["--help", "sync"], "version": true },
    { "id": "help-after-value", "op": "cli", "argv": ["sync", "--scope", "user", "--help"], "version": true },
    { "id": "help-over-unknown-option", "op": "cli", "argv": ["sync", "--bogus", "--help"], "version": true },
    { "id": "help-subcommand", "op": "cli", "argv": ["source", "remove", "shared", "--help"], "version": true },
    { "id": "unknown-command", "op": "cli", "argv": ["frobnicate"] },
    { "id": "unknown-command-option", "op": "cli", "argv": ["frobnicate", "--json"] },
    { "id": "unknown-command-prototype", "op": "cli", "argv": ["constructor", "--json"] },
    { "id": "unknown-command-unsafe", "op": "cli", "argv": ["fr\u00f6b\u001b[31m\u202e"] },
    { "id": "unknown-command-scope", "op": "cli", "argv": ["frobnicate", "--scope", "nope"] },
    { "id": "unknown-source-subcommand", "op": "cli", "argv": ["source", "toString", "--json"] },
    { "id": "unknown-option-first", "op": "cli", "argv": ["--bogus"] },
    { "id": "unknown-option-sync", "op": "cli", "argv": ["sync", "--bogus"] },
    { "id": "unknown-option-sync-project", "op": "cli", "argv": ["sync", "--project"] },
    { "id": "unknown-option-sync-short", "op": "cli", "argv": ["sync", "-x"] },
    { "id": "unknown-option-sync-after-value", "op": "cli", "argv": ["sync", "--scope=user", "--jsn"] },
    { "id": "unknown-option-check", "op": "cli", "argv": ["check", "--force"] },
    { "id": "unknown-option-status", "op": "cli", "argv": ["status", "--force"] },
    { "id": "unknown-option-install-json", "op": "cli", "argv": ["install", "foo@shared", "--json"] },
    { "id": "unknown-option-install-scope", "op": "cli", "argv": ["install", "foo@shared", "--scope", "user"] },
    { "id": "unknown-option-uninstall", "op": "cli", "argv": ["uninstall", "foo@shared", "--force"] },
    { "id": "unknown-option-add", "op": "cli", "argv": ["add", "x", "${TMP}/nowhere", "--json"] },
    { "id": "unknown-option-source-list", "op": "cli", "argv": ["source", "list", "--force"] },
    { "id": "unknown-option-source-remove", "op": "cli", "argv": ["source", "remove", "shared", "--json"] },
    { "id": "unknown-option-available", "op": "cli", "argv": ["available", "--project"] },
    { "id": "unknown-option-trust", "op": "cli", "argv": ["trust", "shared", "--json"] },
    { "id": "accepted-sync", "op": "cli", "argv": ["sync", "--json", "--force", "--scope", "user", "--project-dir", "${TMP}/cwd", "--bogus"] },
    { "id": "accepted-check", "op": "cli", "argv": ["check", "--json", "--scope=all", "--bogus"] },
    { "id": "accepted-status", "op": "cli", "argv": ["status", "--json", "--scope", "project", "--bogus"] },
    { "id": "accepted-available", "op": "cli", "argv": ["available", "shared", "--json", "--bogus"] },
    { "id": "accepted-source-list", "op": "cli", "argv": ["source", "list", "--json", "--bogus"] },
    { "id": "accepted-source-remove", "op": "cli", "argv": ["source", "remove", "shared", "--project", "--force", "--bogus"] },
    { "id": "accepted-add", "op": "cli", "argv": ["add", "extra", "${TMP}/nowhere", "--project", "--bogus"] },
    { "id": "accepted-install", "op": "cli", "argv": ["install", "foo@shared", "--project", "--project-dir=${TMP}/cwd", "--bogus"] },
    { "id": "accepted-uninstall", "op": "cli", "argv": ["uninstall", "foo@shared", "--project", "--bogus"] },
    { "id": "accepted-trust", "op": "cli", "argv": ["trust", "shared", "--project-dir", "${TMP}/cwd", "--bogus"] },
    { "id": "invalid-scope", "op": "cli", "argv": ["status", "--scope", "everything"] },
    { "id": "invalid-scope-no-value", "op": "cli", "argv": ["check", "--scope"] },
    { "id": "add-no-spec", "op": "cli", "argv": ["add"] },
    { "id": "source-no-subcommand", "op": "cli", "argv": ["source"] },
    { "id": "source-remove-no-name", "op": "cli", "argv": ["source", "remove"] },
    { "id": "install-no-item", "op": "cli", "argv": ["install"] },
    { "id": "uninstall-no-item", "op": "cli", "argv": ["uninstall", "--project"] },
    { "id": "trust-no-name", "op": "cli", "argv": ["trust"] },
    { "id": "trust-empty-name", "op": "cli", "argv": ["trust", ""], "tree": true }
  ]
}
