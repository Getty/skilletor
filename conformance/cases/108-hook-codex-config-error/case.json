{
  "description": "SessionStart under Codex with a config that does not load: the warning line names the error, and the context is the last good rules files – the user's, then the project's – as they are on disk; nothing written. Without --harness codex the line alone.",
  "claude": false,
  "steps": [
    {
      "id": "start",
      "op": "cli",
      "argv": [
        "hook",
        "session-start",
        "--harness",
        "codex"
      ],
      "stdin": {
        "hook_event_name": "SessionStart",
        "source": "startup",
        "session_id": "s1",
        "cwd": "${PROJECT}"
      },
      "tree": true
    },
    {
      "id": "claude",
      "op": "cli",
      "argv": [
        "hook",
        "session-start"
      ],
      "stdin": {
        "hook_event_name": "SessionStart",
        "source": "startup",
        "session_id": "s1",
        "cwd": "${PROJECT}"
      }
    }
  ]
}
