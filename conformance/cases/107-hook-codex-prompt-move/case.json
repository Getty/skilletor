{
  "description": "Codex's prompt hook follows a move (k149; Codex alone, hook trusted, gitInit): a session started outside any project, then a prompt in a checkout with a config: its project scope is synced before the prompt returns, the line and the context name the checkout, the pending report waiting there joined to both; the same prompt again, and one from a subdirectory of that checkout, are silent.",
  "git": {
    "shared": {
      "url": "https://conformance.invalid/shared.git",
      "commits": [
        {
          "tree": "sources/shared"
        }
      ]
    }
  },
  "claude": false,
  "gitInit": [
    "project"
  ],
  "steps": [
    {
      "id": "start",
      "op": "cli",
      "argv": [
        "hook",
        "session-start",
        "--harness",
        "codex"
      ],
      "stdin": {
        "hook_event_name": "SessionStart",
        "source": "startup",
        "session_id": "s1",
        "cwd": "${TMP}/cwd"
      }
    },
    {
      "id": "moved",
      "op": "cli",
      "argv": [
        "hook",
        "user-prompt-submit",
        "--harness",
        "codex"
      ],
      "stdin": {
        "hook_event_name": "UserPromptSubmit",
        "session_id": "s1",
        "cwd": "${PROJECT}"
      },
      "tree": true
    },
    {
      "id": "again",
      "op": "cli",
      "argv": [
        "hook",
        "user-prompt-submit",
        "--harness",
        "codex"
      ],
      "stdin": {
        "hook_event_name": "UserPromptSubmit",
        "session_id": "s1",
        "cwd": "${PROJECT}"
      }
    },
    {
      "id": "subdir",
      "op": "cli",
      "argv": [
        "hook",
        "user-prompt-submit",
        "--harness",
        "codex"
      ],
      "stdin": {
        "hook_event_name": "UserPromptSubmit",
        "session_id": "s1",
        "cwd": "${PROJECT}/sub"
      },
      "tree": true
    }
  ]
}
